# ---- filesystems + container support (Debian rootfs, Waydroid)
CONFIG_EXT4_FS=y
CONFIG_F2FS_FS=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_NET_NS=y
CONFIG_OVERLAY_FS=y
CONFIG_FUSE_FS=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_WRITEBACK=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_DEVICE=y
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
# ashmem was removed from upstream: Android 11+ passes the
# buffers over binder's own dmabuf heap, so nothing needs it.
CONFIG_KEYS=y
# ---- SELinux, which is why the image used to reboot after ~10 seconds
# AppArmor was a ROCKNIX leftover and this ROM never ships an AppArmor policy.
# Android's first-stage init mounts selinuxfs at /sys/fs/selinux and PLOG(FATAL)s
# when it cannot, and init's death is a panic -> reboot a few seconds after boot,
# before logd has started, which is why there was never a logcat or a last_kmsg.
# SELINUX depends on SECURITY_NETWORK && AUDIT && NET && INET; AppArmor used to
# select SECURITY_NETWORK, so with it off the dependency has to be named here or
# SECURITY_SELINUX silently never appears in .config.
CONFIG_AUDIT=y
# SELinux depends on SECURITY_NETWORK && AUDIT && NET && INET (security/selinux/Kconfig).
# AppArmor used to select SECURITY_NETWORK; with AppArmor off the dependency has to be
# named here or SECURITY_SELINUX silently disappears from .config and first-stage init
# dies in SetupSelinux() when it cannot mount selinuxfs at /sys/fs/selinux.
CONFIG_SECURITY_NETWORK=y
CONFIG_NETWORK_SECMARK=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_DEVELOP=y
CONFIG_SECURITY_SELINUX_AVC_STATS=y
CONFIG_SECURITY_SELINUX_SIDTAB_HASH_BITS=9
CONFIG_SECURITY_SELINUX_SID2STR_CACHE_SIZE=256
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,selinux,smack,tomoyo,apparmor,bpf"
# CONFIG_SECURITY_APPARMOR is not set
# the ROM's init sets up zram swap on a 4 GB device, and with no module
# channel it has to be built in or the swap line in fstab.qcom just fails.
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
CONFIG_ZRAM_BACKEND_LZO=y
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
# pstore holds ONE backend (fs/pstore/platform.c: register_pstore_backend
# returns -EBUSY once psinfo is set), and ramoops registers at subsys_initcall
# while pstore_blk registers at late_initcall, so keeping both means the block
# backend never attaches and nothing survives a reboot. The DRAM ring cannot be
# read back on this device anyway - stock Android has no /dev/mem (CONFIG_DEVMEM
# is off there) and its own ramoops driver re-initialises the ring header at
# probe - so the flash records are the only log that outlives the boot that
# wrote it. The /reserved-memory ramoops node stays in the DTS regardless: it
# keeps that DRAM out of the page allocator, which is what the vendor's
# subsystem firmware expects.
CONFIG_PSTORE_BLK=y
CONFIG_PSTORE_BLK_BLKDEV="PARTLABEL=oops"
# These are in KIBIBYTES (fs/pstore/blk.c check_size(): `name * 1024`), and the
# 4096 in verify_size(name, 4096, ...) is a byte *alignment*, not a minimum - so
# what 2 used to mean here. 256 is 256 KiB, which holds several times the whole
# boot log and still fits the smallest plausible oops partition (register_pstore_zone
# fails outright if the zones do not fit, so being modest costs nothing but
# truncated records). console and pmsg stay 0: with a block backend every
# console line would be a synchronous O_DSYNC write, which is not something a
# phone boot should pay.
CONFIG_PSTORE_BLK_KMSG_SIZE=256
CONFIG_PSTORE_BLK_CONSOLE_SIZE=0
CONFIG_PSTORE_BLK_PMSG_SIZE=0
# enum kmsg_dump_reason in 7.1.2 is UNDEF=0 PANIC=1 OOPS=2 EMERG=3 SHUTDOWN=4,
# and kmsg_dump() skips a dumper when reason > max_reason. A first-stage init
# that gives up calls reboot(2), whose kernel_restart() dumps with
# KMSG_DUMP_SHUTDOWN - with the default of 2 the record was filtered out and
# the partition kept whatever the previous boot left there.
CONFIG_PSTORE_BLK_MAX_REASON=4
# CONFIG_PSTORE_RAM is not set

# ---- networking
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_BRIDGE=y

# ---- debug
CONFIG_DEBUG_KERNEL=y
CONFIG_FTRACE=y
CONFIG_KALLSYMS=y
CONFIG_PRINTK_TIME=y

# ---- boot handover (see arch/arm64/kernel/handover.c, tools/shim.S)
# Both of these are load bearing, not tuning: without the hook the kernel never
# sees ABL's androidboot.* tags or the address of the ROM's first stage init
# ramdisk, and with INITRD off it could not load that ramdisk if it did. CI
# asserts both are still y after olddefconfig.
CONFIG_ARM64_HANDOVER_CMDLINE=y
CONFIG_BLK_DEV_INITRD=y

# ---- boot-critical symbols audited against stock/gki.config
# Everything below is =y in the vendor 6.6.82 config this ROM boots with today and
# was absent here.  The list was produced by name-diffing the two configs and then
# re-running the CI Configure step (defconfig, =m to =n, merge, olddefconfig) with
# each line in it: a name only stays if it still resolves to =y, because that step
# fails the build on any =y line that does not land.  Symbols stock has that 7.1.2
# no longer defines are therefore missing on purpose - dm-default-key (the
# default-key DM target the ROM's vold asks for, which has to come back as a local
# driver), the arm64 CE/NEON crypto glue, the dma-buf heap tuning knobs,
# ashmem and the GKI-only ANDROID_* / UID_SYS_STATS hooks.

# ---- device-mapper: /vendor, /odm and /data are all mapped devices
# fs_mgr builds a linear target across the super partition for every logical
# partition, verifies it with verity (FEC needs the crc32/crc32c libraries), and
# stacks crypt on top for /data.  arch/arm64/configs/defconfig leaves the whole
# MD/DM stack off, so without this nothing in first stage can mount anything.
CONFIG_BLK_DEV_DM=y
CONFIG_BLK_DEV_DM_BUILTIN=y
CONFIG_DM_BUFIO=y
CONFIG_DM_CRYPT=y
CONFIG_DM_SNAPSHOT=y
CONFIG_DM_UEVENT=y
CONFIG_DM_VERITY=y
CONFIG_DM_VERITY_FEC=y
CONFIG_MD=y
# /data is not mounted on the crypt target: this ROM's fstab asks for
# metadata_encryption=aes-256-xts:wrappedkey_v0, and fs_mgr implements that with
# a *default-key* target, which encrypts everything below it with one key except
# the bios fscrypt has already given a per-file key.  Mainline does not ship it,
# so it is backported by patches/local/0007-dm-default-key.patch together with
# the bio->bi_skip_dm_default_key flag that target reads.
CONFIG_DM_DEFAULT_KEY=y
# The target is only half the path; the key has to be programable.  ICE is
# reached through the blk-crypto profile that drivers/soc/qcom/ice.c registers
# for the ufs host (qcom,ice = <&ice_ufs_mem> in the DTS), and
# qcom_ice.use_wrapped_keys=1 on the cmdline is what makes it advertise
# HW_WRAPPED instead of RAW.  The fallback keeps file contents working in
# software if ICE never gets bound.
CONFIG_BLK_INLINE_ENCRYPTION=y
CONFIG_BLK_INLINE_ENCRYPTION_FALLBACK=y

# ---- filesystems this ROM is actually formatted with
# vendor.img in this build is ext4, the same fstab names EROFS on other Infinity X
# builds, and /data is F2FS with compression, quotas and checkpointing
# (quota,checkpoint=fs in its options column).  FS_ENCRYPTION is what
# fileencryption=aes-256-xts:aes-256-cts:v2 asks for and FS_ENCRYPTION_INLINE_CRYPT
# is the handshake with UFS ICE: without it vold installs software keys and every
# file already on /data decrypts to garbage.
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_PCPU_KTHREAD=y
CONFIG_EROFS_FS_PCPU_KTHREAD_HIPRI=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_SECURITY=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_F2FS_FS_COMPRESSION=y
CONFIG_F2FS_FS_LZ4=y
CONFIG_F2FS_FS_LZ4HC=y
CONFIG_F2FS_FS_LZO=y
CONFIG_F2FS_FS_LZORLE=y
CONFIG_F2FS_FS_POSIX_ACL=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_F2FS_FS_XATTR=y
CONFIG_F2FS_FS_ZSTD=y
CONFIG_F2FS_UNFAIR_RWSEM=y
CONFIG_FS_ENCRYPTION=y
CONFIG_FS_ENCRYPTION_ALGS=y
CONFIG_FS_ENCRYPTION_INLINE_CRYPT=y
CONFIG_FS_VERITY=y
CONFIG_QFMT_V2=y
CONFIG_QUOTA=y
CONFIG_QUOTACTL=y
CONFIG_QUOTA_TREE=y

# ---- the crypto API, as Android userspace reaches it
# Mostly algorithms named by fstab strings (adiantum, hctr2, xctr, cts) plus the
# pieces dm-verity-fec and dm-crypt need (ghash, poly1305, blake2b, essiv, seqiv,
# crc32) and the rng stack that key generation goes through.  The arm64 CE/NEON
# glue symbols stock sets no longer exist as names in 7.1.2 - the accelerated
# implementations are selected by the architecture there - so they are absent
# from this list rather than missing.
CONFIG_CRYPTO=y
CONFIG_CRYPTO_ACOMP2=y
CONFIG_CRYPTO_ADIANTUM=y
CONFIG_CRYPTO_AEAD2=y
CONFIG_CRYPTO_AEAD=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_AES_ARM64_CE_BLK=y
CONFIG_CRYPTO_AKCIPHER2=y
CONFIG_CRYPTO_AKCIPHER=y
CONFIG_CRYPTO_ALGAPI2=y
CONFIG_CRYPTO_ALGAPI=y
CONFIG_CRYPTO_AUTHENC=y
CONFIG_CRYPTO_BLAKE2B=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_CCM=y
CONFIG_CRYPTO_CHACHA20=y
CONFIG_CRYPTO_CHACHA20POLY1305=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_CRC32=y
CONFIG_CRYPTO_CRC32C=y
CONFIG_CRYPTO_CTR=y
CONFIG_CRYPTO_CTS=y
CONFIG_CRYPTO_DEFLATE=y
CONFIG_CRYPTO_DES=y
CONFIG_CRYPTO_DEV_ALLWINNER=y
CONFIG_CRYPTO_ECB=y
CONFIG_CRYPTO_ECC=y
CONFIG_CRYPTO_ECDH=y
CONFIG_CRYPTO_ECHAINIV=y
CONFIG_CRYPTO_ESSIV=y
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_GENIV=y
CONFIG_CRYPTO_GHASH_ARM64_CE=y
CONFIG_CRYPTO_HASH2=y
CONFIG_CRYPTO_HASH=y
CONFIG_CRYPTO_HASH_INFO=y
CONFIG_CRYPTO_HCTR2=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_HW=y
CONFIG_CRYPTO_JITTERENTROPY=y
CONFIG_CRYPTO_KPP2=y
CONFIG_CRYPTO_KPP=y
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_LZO=y
CONFIG_CRYPTO_MANAGER2=y
CONFIG_CRYPTO_MANAGER=y
CONFIG_CRYPTO_MD5=y
CONFIG_CRYPTO_NULL=y
CONFIG_CRYPTO_RNG2=y
CONFIG_CRYPTO_RNG=y
CONFIG_CRYPTO_RSA=y
CONFIG_CRYPTO_SEQIV=y
CONFIG_CRYPTO_SHA1=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA3=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_SIG2=y
CONFIG_CRYPTO_SIG=y
CONFIG_CRYPTO_SKCIPHER2=y
CONFIG_CRYPTO_SKCIPHER=y
CONFIG_CRYPTO_XCBC=y
CONFIG_CRYPTO_XCTR=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_ZSTD=y

# ---- compression and checksum backends
# lz4/zstd plus the decompress_* pair are the EROFS and F2FS compression codecs,
# the pstore record compressor and zram; crc32 is verity-FEC's checksum.
CONFIG_CRC32=y
CONFIG_DECOMPRESS_GZIP=y
CONFIG_DECOMPRESS_LZ4=y
CONFIG_DECOMPRESS_ZSTD=y
CONFIG_LZ4HC_COMPRESS=y
CONFIG_LZ4_COMPRESS=y
CONFIG_LZ4_DECOMPRESS=y
CONFIG_ZSTD_COMMON=y
CONFIG_ZSTD_COMPRESS=y
CONFIG_ZSTD_DECOMPRESS=y

# ---- netd, tethering, VPN
# stock/gki.config turns NF_TABLES off and carries the entire legacy xtables set,
# which means this ROM's netd drives iptables-legacy.  In 7.1.2 those table
# options moved behind NETFILTER_XTABLES_LEGACY, so both backends are enabled
# here: the legacy one because the vendor config proves that is what the userspace
# was built against, and nftables because AOSP has been moving to it.  XFRM/ESP
# plus wireguard are the VPN paths, the NET_SCH/NET_CLS/NET_ACT set is what tc
# needs for the per-uid qdiscs, and FIB_RULES/IP_MULTIPLE_TABLES for the policy
# routing rules netd installs.
CONFIG_BRIDGE_NF_EBTABLES_LEGACY=y
CONFIG_DUMMY=y
CONFIG_FIB_RULES=y
CONFIG_INET_DIAG=y
CONFIG_INET_DIAG_DESTROY=y
CONFIG_INET_ESP=y
CONFIG_INET_TABLE_PERTURB_ORDER=16
CONFIG_INET_TCP_DIAG=y
CONFIG_INET_TUNNEL=y
CONFIG_INET_UDP_DIAG=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_IPTABLES_LEGACY=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP6_NF_MATCH_RPFILTER=y
CONFIG_IP6_NF_RAW=y
CONFIG_IP6_NF_TARGET_REJECT=y
CONFIG_IPV6_GRE=y
CONFIG_IPV6_MIP6=y
CONFIG_IPV6_MROUTE=y
