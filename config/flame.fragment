CONFIG_DUMMY=y
CONFIG_FIB_RULES=y
CONFIG_INET_DIAG=y
CONFIG_INET_DIAG_DESTROY=y
CONFIG_INET_ESP=y
CONFIG_INET_TABLE_PERTURB_ORDER=16
CONFIG_INET_TCP_DIAG=y
CONFIG_INET_TUNNEL=y
CONFIG_INET_UDP_DIAG=y
