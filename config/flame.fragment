CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_REGULATOR_QCOM_LABIBB=y
CONFIG_LEDS_CLASS=y
CONFIG_PWM=y
# the LPG driver lives under drivers/leds/rgb/, which the whole of Kconfig
