CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_F_FS=y
# f_acc and f_audio_source were dropped upstream; adb, mtp and ptP on Android
# 11+ all go through f_fs, which is above.
CONFIG_USB_ACM=y
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_CONSOLE=y
CONFIG_USB_SERIAL_QCAUX=y
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_NET_RNDIS_HOST=y
CONFIG_USB_NET_QMI_WWAN=y

# ---- display: DPU + DSI + panel + backlight; mainline has a real VT
CONFIG_DRM=y
CONFIG_DRM_MSM=y
CONFIG_DRM_DISPLAY_DP_AUX_CHARDEV=y
CONFIG_DRM_PANEL=y
CONFIG_DRM_PANEL_SIMPLE=y
CONFIG_DRM_PANEL_XIAOMI_C3F=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_FBDEV_OVERALLOC=100

# A second, deliberately useless DRM driver, purely to own a render node.
# The ROM's GPU userspace is Adreno proprietary, and its system layer
# (libgsl.so) chooses a kernel backend with access() in gsl_ioctl_init: it
# tries /dev/kgsl-3d0, then /dev/dri/renderD129, and if neither exists it logs
# "Device access failed, stub the gpu" and hands EGL, Vulkan, the camera and
# the codecs a null driver. We have no kgsl, so the DRM backend is the only
# way in - and it is only entered when the path /dev/dri/renderD129 exists,
# even though the code behind it opendir()s /dev/dri and readdir()s every
# render* node, opening each and matching DRM_IOCTL_VERSION's driver name, so
# it lands on the real msm node whichever number it ended up with. vgem
# (DRIVER_GEM | DRIVER_RENDER, no hardware behind it) is what makes the second
# node exist.
#
# Which card gets which number is not something that can be left to chance
# here, and that is what patches/local/0008 and the manifest rule after it fix:
# primary and render minors come out of one xarray in registration order, and
# /vendor/etc/selinux/vendor_file_contexts labels exactly card0, controlD64 and
# renderD128 as graphics_device - everything else is plain `device`, which
# plat_sepolicy.cil lets no domain open. vgem's own initcall used to win the
# race (msm only registers when its components bind), so vgem took card0 and
# renderD128 and the real GPU landed on renderD129, where nothing can open it:
# dark screen, not a slow one. msm is now registered first and calls vgem_init()
# itself, so the three labelled names are the real driver's and vgem sits at
# renderD129 as the placeholder libgsl only needs to see.  Requires =y, not =m:
# that is a direct call.
# Nothing hardcodes a card path either - the
# composer reaches the display through libdrm's name-based drmOpen("msm"), and
# libsdedrm.so contains no /dev/dri string at all.
#
# What the DRM backend then calls is the upstream msm UAPI, checked against
# this tree's own headers rather than assumed: GEM_NEW 0xc0106442, GEM_INFO
# 0xc0186443, GEM_SUBMIT 0xc0486446, SUBMITQUEUE_NEW 0xc00c644a,
# SUBMITQUEUE_CLOSE 0x4004644b, GET_PARAM 0xc0186440 - matching command numbers
# *and* struct sizes. That is why this config line, and not a kgsl port, is
# what gets hardware acceleration on this kernel.
CONFIG_DRM_VGEM=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_FB=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# The console on the splash the bootloader left on screen. dts declares the ABL
# image region as both a reserved-memory node and a simple-framebuffer, and the
# DPU is still scanning it out when we are handed control (clk_ignore_unused
# keeps it that way), so FB_SIMPLE binds it and fbcon writes the boot log into
# the picture the panel is already showing. This is not a pretty boot: it is
# the only channel that needs no working USB, no pstore, no recovery and no
# UART cable. If a boot fails with nothing on the screen at all, the kernel
# never got this far and the fault is in the shim or below.
CONFIG_FB_SIMPLE=y
# A primary-console veto would read /chosen/stdout-path, which points at the
# debug UART, and fbcon would then map the panel only if it were the primary
# device. DRM_MSM selects DRM_CLIENT_SETUP, which selects
# FRAMEBUFFER_CONSOLE_DETECT_PRIMARY, so that heuristic cannot be turned off
# from a fragment - the fbcon=map:0 in the bootargs is what overrides it, and
# the console goes to the first framebuffer regardless of what stdout-path says.
# map:0 only chooses the framebuffer; the console itself has to be named, so the
# bootargs also carry console=tty0 (see the comment over bootargs in the dts for
# why an unmatched console driver is not enabled at all).
CONFIG_LOGO=y
CONFIG_SYNC_FILE=y
CONFIG_UDMABUF=y
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_DMABUF_HEAPS_CMA=y
CONFIG_CMA=y

# The names above are "system" and (if a CMA area exists) "reserved", and the
# ROM's allocator will not accept either one. Its buffers come from
# vendor.qti.hardware.display.snapalloc-impl.so / libgralloccore.so, which ask
# for /dev/dma_heap/qcom,system, qcom,system-uncached, qcom,system-movable,
# qcom,display ... by literal, allocate through exactly that one name with no
# retry, and treat the failure as fatal (the whole call chain, with addresses,
# is written up in the manifest rule that adds the alias; qcom,user-contig and
# qcom,demura are not on that chain but are nodes the ROM's own
# vendor_file_contexts labels, so something else opens them). SurfaceFlinger
# gets no buffer at all without them, so this is not a nice-to-have.
#
# The aliases are names only: the pages come from the buddy allocator like the
# mainline system heap. Deliberately NOT aliased are the secure heaps
# (qcom,secure-pixel, qcom,cp_camera, qcom,qseecom..., all in the ROM's
# vendor_file_contexts) because those hand out TrustZone-protected memory, and
# the DSP-shared ones (qcom,adsp, qcom,ubwcp) because normal pages the DSP
# cannot see would turn a clean "cannot open heap" into silent audio corruption.
# What that costs: DRM-protected video (Widevine L1) and secure capture fail,
# and anything that really needs ADSP-shared buffers fails. A normal UI,
# camera preview and playback from these heaps are unaffected, and the SMMU in
# front of the display, camera and codec blocks is what makes non-contiguous
# system pages usable for them.
CONFIG_DMABUF_HEAPS_QCOM_COMPAT=y

# ---- input
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_UINPUT=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_EDT_FT5X06=y
CONFIG_HID=y
CONFIG_HID_MULTITOUCH=y

# ---- sound: LPASS macros, soundwire, smartpa
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_QCOM=y
CONFIG_SND_SOC_SC8280XP=y
CONFIG_SND_SOC_WCD938X=y
CONFIG_SND_SOC_WCD938X_SDW=y
CONFIG_SND_SOC_WCD939X=y
CONFIG_SND_SOC_WCD939X_SDW=y
CONFIG_SND_SOC_WSA884X=y
CONFIG_SND_SOC_WSA881X=y
CONFIG_SND_SOC_WSA883X=y
CONFIG_SND_SOC_AW88166=y
CONFIG_SND_SOC_LPASS_WSA_MACRO=y
CONFIG_SND_SOC_LPASS_VA_MACRO=y
CONFIG_SND_SOC_LPASS_RX_MACRO=y
CONFIG_SND_SOC_LPASS_TX_MACRO=y
CONFIG_SOUNDWIRE=y
CONFIG_SOUNDWIRE_QCOM=y

# ---- wireless: BT is hci_qca; the WCN3990 WLAN path is still open
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_CFG80211_WEXT=y
CONFIG_MAC80211=y
CONFIG_NL80211_TESTMODE=y
CONFIG_RFKILL=y
CONFIG_BT=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_QCA=y
CONFIG_BT_QCA=y
CONFIG_WCN36XX=y
CONFIG_ATH10K=y
CONFIG_ATH10K_SNOC=y
CONFIG_ATH11K=y
CONFIG_CRC8=y

# ---- remoteproc / glink / fastrpc (ADSP for audio, WPSS for wifi)
CONFIG_REMOTEPROC=y
CONFIG_QCOM_RPROC_COMMON=y
CONFIG_QCOM_MDT_LOADER=y
CONFIG_QCOM_Q6V5_MSS=y
CONFIG_QCOM_Q6V5_ADSP=y
CONFIG_QCOM_Q6V5_PAS=y
CONFIG_QCOM_Q6V5_WCSS=y
CONFIG_QCOM_SYSMON=y
CONFIG_RPMSG_QCOM_GLINK=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_RPMSG_QCOM_GLINK_RPM=y
CONFIG_QCOM_APR=y
CONFIG_RPMSG_QCOM_SMD=y
CONFIG_QCOM_FASTRPC=y
CONFIG_QRTR=y
CONFIG_QRTR_SMD=y

# ---- filesystems + container support (Debian rootfs, Waydroid)
CONFIG_EXT4_FS=y
CONFIG_F2FS_FS=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_NET_NS=y
CONFIG_OVERLAY_FS=y
CONFIG_FUSE_FS=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_WRITEBACK=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_DEVICE=y
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
# ashmem was removed from upstream: Android 11+ passes the
# buffers over binder's own dmabuf heap, so nothing needs it.
CONFIG_KEYS=y
# ---- SELinux, which is why the image used to reboot after ~10 seconds
# AppArmor was a ROCKNIX leftover and this ROM never ships an AppArmor policy.
# Android's first-stage init mounts selinuxfs at /sys/fs/selinux and PLOG(FATAL)s
# when it cannot, and init's death is a panic -> reboot a few seconds after boot,
# before logd has started, which is why there was never a logcat or a last_kmsg.
# SELINUX depends on SECURITY_NETWORK && AUDIT && NET && INET; AppArmor used to
# select SECURITY_NETWORK, so with it off the dependency has to be named here or
# SECURITY_SELINUX silently never appears in .config.
CONFIG_AUDIT=y
# SELinux depends on SECURITY_NETWORK && AUDIT && NET && INET (security/selinux/Kconfig).
# AppArmor used to select SECURITY_NETWORK; with AppArmor off the dependency has to be
# named here or SECURITY_SELINUX silently disappears from .config and first-stage init
# dies in SetupSelinux() when it cannot mount selinuxfs at /sys/fs/selinux.
CONFIG_SECURITY_NETWORK=y
CONFIG_NETWORK_SECMARK=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_DEVELOP=y
CONFIG_SECURITY_SELINUX_AVC_STATS=y
CONFIG_SECURITY_SELINUX_SIDTAB_HASH_BITS=9
CONFIG_SECURITY_SELINUX_SID2STR_CACHE_SIZE=256
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,selinux,smack,tomoyo,apparmor,bpf"
# CONFIG_SECURITY_APPARMOR is not set
# the ROM's init sets up zram swap on a 4 GB device, and with no module
# channel it has to be built in or the swap line in fstab.qcom just fails.
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
CONFIG_ZRAM_BACKEND_LZO=y
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
# pstore holds ONE backend (fs/pstore/platform.c: register_pstore_backend
# returns -EBUSY once psinfo is set), and ramoops registers at subsys_initcall
# while pstore_blk registers at late_initcall, so keeping both means the block
# backend never attaches and nothing survives a reboot. The DRAM ring cannot be
# read back on this device anyway - stock Android has no /dev/mem (CONFIG_DEVMEM
# is off there) and its own ramoops driver re-initialises the ring header at
# probe - so the flash records are the only log that outlives the boot that
# wrote it. The /reserved-memory ramoops node stays in the DTS regardless: it
# keeps that DRAM out of the page allocator, which is what the vendor's
# subsystem firmware expects.
CONFIG_PSTORE_BLK=y
# "oops" is assumed, not measured: no shell reached here has ever listed this
# device's partitions. It is the common name for the dump partition on Xiaomi
# boards and the one flash-boot.txt reads back, and if it is wrong the cost is
# the log only - pstore_blk.best_effort=1 on the kernel line means a missing
# partition leaves the backend unregistered and the boot otherwise identical.
CONFIG_PSTORE_BLK_BLKDEV="PARTLABEL=oops"
# These are in KIBIBYTES (fs/pstore/blk.c check_size(): `name * 1024`), and the
# 4096 in verify_size(name, 4096, ...) is a byte *alignment*, not a minimum: a
# value whose KiB number is not page-multiple gets replaced by ALIGN(kib, 4096)
# read back as bytes, which is how KMSG_SIZE=2 became a 4096-byte zone.  256 is
# 256 KiB, several times the whole boot log, and modest enough to fit any dump
# partition - register_pstore_zone() fails outright when the zones do not fit,
# and then nothing is recorded at all. console and pmsg stay 0: with a block
# backend every console line would be a synchronous O_DSYNC write, which is not
# something a phone boot should pay.
CONFIG_PSTORE_BLK_KMSG_SIZE=256
CONFIG_PSTORE_BLK_CONSOLE_SIZE=0
CONFIG_PSTORE_BLK_PMSG_SIZE=0
# enum kmsg_dump_reason in 7.1.2 is UNDEF=0 PANIC=1 OOPS=2 EMERG=3 SHUTDOWN=4,
# and kmsg_dump() skips a dumper when reason > max_reason. A first-stage init
# that gives up calls reboot(2), whose kernel_restart() dumps with
# KMSG_DUMP_SHUTDOWN - with the default of 2 the record was filtered out and
# the partition kept whatever the previous boot left there.
CONFIG_PSTORE_BLK_MAX_REASON=4
# CONFIG_PSTORE_RAM is not set

# ---- networking
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_BRIDGE=y

# ---- debug
CONFIG_DEBUG_KERNEL=y
CONFIG_FTRACE=y
CONFIG_KALLSYMS=y
CONFIG_PRINTK_TIME=y
# An oops that does not panic is a message in a buffer nobody reads: the
# kmsg_dump that writes the pstore record runs from the panic path, so a
# non-fatal oops leaves a dead thread, a first stage that carries on broken and
# no record at all.  Stock sets it (=y with panic_on_oops=1 in its own config);
# 7.1.2 has no PANIC_ON_OOPS_VALUE symbol any more, the bool is the whole knob.
# With PANIC_TIMEOUT left at its 0 default the resulting panic then halts with
# the text still on the panel instead of rebooting over it.
CONFIG_PANIC_ON_OOPS=y
# A CPU stuck in a kernel loop is the other failure that looks like nothing: no
# panic, no oops, no record, the panel frozen mid-line. Stock runs the same
# detectors, and a hard lockup panicking is what turns it into a pstore record
# and a reboot instead of a device that sits there until the battery dies. Soft
# lockups still only complain: first stage can legitimately sit in one path for
# minutes on a slow UFS, and panicking over that would break working boots.
CONFIG_LOCKUP_DETECTOR=y
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_HARDLOCKUP_PANIC=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=120

# ---- boot handover (see arch/arm64/kernel/handover.c, tools/shim.S)
# Both of these are load bearing, not tuning: without the hook the kernel never
# sees ABL's androidboot.* tags or the address of the ROM's first stage init
# ramdisk, and with INITRD off it could not load that ramdisk if it did. CI
# asserts both are still y after olddefconfig.
CONFIG_ARM64_HANDOVER_CMDLINE=y
CONFIG_BLK_DEV_INITRD=y

# ---- boot-critical symbols audited against stock/gki.config
# Everything below is =y in the vendor 6.6.82 config this ROM boots with today and
# was absent here.  The list was produced by name-diffing the two configs and then
# re-running the CI Configure step (defconfig, =m to =n, merge, olddefconfig) with
# each line in it: a name only stays if it still resolves to =y, because that step
# fails the build on any =y line that does not land.  Symbols stock has that 7.1.2
# no longer defines are therefore missing on purpose - dm-default-key (the
# default-key DM target the ROM's vold asks for, which has to come back as a local
# driver), the arm64 CE/NEON crypto glue, the dma-buf heap tuning knobs,
# ashmem and the GKI-only ANDROID_* / UID_SYS_STATS hooks.

# ---- device-mapper: /vendor, /odm and /data are all mapped devices
# fs_mgr builds a linear target across the super partition for every logical
# partition, verifies it with verity (FEC needs the crc32/crc32c libraries), and
# stacks crypt on top for /data.  arch/arm64/configs/defconfig leaves the whole
# MD/DM stack off, so without this nothing in first stage can mount anything.
CONFIG_BLK_DEV_DM=y
CONFIG_BLK_DEV_DM_BUILTIN=y
CONFIG_DM_BUFIO=y
CONFIG_DM_CRYPT=y
CONFIG_DM_SNAPSHOT=y
CONFIG_DM_UEVENT=y
CONFIG_DM_VERITY=y
CONFIG_DM_VERITY_FEC=y
CONFIG_MD=y
# /data is not mounted on the crypt target: this ROM's fstab asks for
# metadata_encryption=aes-256-xts:wrappedkey_v0, and fs_mgr implements that with
# a *default-key* target, which encrypts everything below it with one key except
# the bios fscrypt has already given a per-file key.  Mainline does not ship it,
# so it is backported by patches/local/0007-dm-default-key.patch together with
# the bio->bi_skip_dm_default_key flag that target reads.
CONFIG_DM_DEFAULT_KEY=y
# The target is only half the path; the key has to be programable.  ICE is
# reached through the blk-crypto profile that drivers/soc/qcom/ice.c registers
# for the ufs host (qcom,ice = <&ice_ufs_mem> in the DTS), and
# qcom_ice.use_wrapped_keys=1 on the cmdline is what makes it advertise
# HW_WRAPPED instead of RAW.  The fallback keeps file contents working in
# software if ICE never gets bound.
CONFIG_BLK_INLINE_ENCRYPTION=y
CONFIG_BLK_INLINE_ENCRYPTION_FALLBACK=y

# ---- filesystems this ROM is actually formatted with
# vendor.img in this build is ext4, the same fstab names EROFS on other Infinity X
# builds, and /data is F2FS with compression, quotas and checkpointing
# (quota,checkpoint=fs in its options column).  FS_ENCRYPTION is what
# fileencryption=aes-256-xts:aes-256-cts:v2 asks for and FS_ENCRYPTION_INLINE_CRYPT
# is the handshake with UFS ICE: without it vold installs software keys and every
# file already on /data decrypts to garbage.
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_PCPU_KTHREAD=y
CONFIG_EROFS_FS_PCPU_KTHREAD_HIPRI=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_SECURITY=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_F2FS_FS_COMPRESSION=y
CONFIG_F2FS_FS_LZ4=y
CONFIG_F2FS_FS_LZ4HC=y
CONFIG_F2FS_FS_LZO=y
CONFIG_F2FS_FS_LZORLE=y
CONFIG_F2FS_FS_POSIX_ACL=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_F2FS_FS_XATTR=y
CONFIG_F2FS_FS_ZSTD=y
CONFIG_F2FS_UNFAIR_RWSEM=y
CONFIG_FS_ENCRYPTION=y
CONFIG_FS_ENCRYPTION_ALGS=y
CONFIG_FS_ENCRYPTION_INLINE_CRYPT=y
CONFIG_FS_VERITY=y
