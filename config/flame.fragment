# flame mainline kernel fragment, merged over arch/arm64/configs/defconfig.
# Unknown symbols are silently dropped by olddefconfig; CI greps this list into
# enabled.txt so a typo shows up as a missing driver rather than a silent hang.

# ---- no modules, ever
# The ROM's first stage insmods 94 stock .ko files, and no channel exists to
# deliver rebuilt ones: the boot image has a kernel section only, /vendor is
# read-only under AVB, and a mainline .ko would not load into a stock kernel or
# the other way round. So a driver configured =m simply does not exist for
# Android, and CONFIG_MODULES=n is what makes that visible at build time:
# with it off, olddefconfig silently demotes every =y below whose dependency is
# a module - DRM_MSM, the whole SND_SOC_QCOM family, remoteproc, LPG LEDs -
# and the Image links without them. It also saves building 1332 unusable
# modules.
CONFIG_MODULES=n

# ---- SoC bus / firmware glue
CONFIG_ARCH_QCOM=y
CONFIG_QCOM_SCM=y
CONFIG_QCOM_SMEM=y
# ROCKNIX 0045 puts qcom_serial_number in socinfo.c and reads it from ath10k
# and btqca, both built in here. As a module its data symbol is not in vmlinux
# and the link fails; it also has to be up before the wifi/bt firmware names
# are derived, so built-in is what flame wants anyway.
CONFIG_QCOM_SOCINFO=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_QCOM_PDC=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_WDT=y
CONFIG_QCOM_STATS=y
CONFIG_QCOM_TSENS=y
CONFIG_QCOM_SPMI_TEMP_ALARM=y
CONFIG_NVMEM=y
CONFIG_NVMEM_QCOM_QFPROM=y
CONFIG_NVMEM_QCOM_SEC_QFPROM=y
CONFIG_RESET_QCOM_PDC=y

# ---- clocks / pinctrl / interconnect / iommu
CONFIG_SM_GCC_4450=y
CONFIG_SM_GPUCC_4450=y
CONFIG_SM_DISPCC_4450=y
CONFIG_SM_CAMCC_4450=y
CONFIG_PINCTRL_SM4450=y
CONFIG_INTERCONNECT=y
CONFIG_INTERCONNECT_QCOM=y
CONFIG_INTERCONNECT_QCOM_RPMH=y
CONFIG_INTERCONNECT_QCOM_BCM_VOTER=y
CONFIG_INTERCONNECT_QCOM_OSM_L3=y
CONFIG_INTERCONNECT_QCOM_SM4450=y
CONFIG_ARM_SMMU=y
CONFIG_ARM_SMMU_QCOM=y
CONFIG_IOMMU_IO_PGTABLE_ARMV7S=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_IDLE_GOV_MENU=y
CONFIG_THERMAL_GOV_POWER_ALLOCATOR=y
CONFIG_PM_DEVFREQ=y
CONFIG_DEVFREQ_GOV_SIMPLE_ONDEMAND=y
CONFIG_DEVFREQ_GOV_PERFORMANCE=y
CONFIG_DEVFREQ_GOV_USERSPACE=y

# ---- GenI: console uart, I2C (touch + pm8010n), SPI, GPI DMA
# QCOM_GPI_UART, _I2C and _SPI were vendor-tree names: upstream routes GPI
# through the same geni-* drivers as the M-AM controllers, gated by
# QCOM_GPI_DMA alone.
CONFIG_QCOM_GENI_SE=y
CONFIG_QCOM_GSBI=y
CONFIG_QCOM_GPI_DMA=y
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_SERIAL_QCOM_GENI_CONSOLE=y
CONFIG_SERIAL_DEV_BUS=y
CONFIG_SERIAL_DEV_CTRL_TTYPORT=y
CONFIG_I2C_QCOM_GENI=y
CONFIG_SPI_QCOM_GENI=y

# ---- SPMI PMICs (pmk8350 / pm6450 / pm8010 / pm7250b)
CONFIG_REGULATOR=y
CONFIG_REGULATOR_QCOM_SPMI=y
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_REGULATOR_QCOM_LABIBB=y
CONFIG_LEDS_CLASS=y
CONFIG_PWM=y
# the LPG driver lives under drivers/leds/rgb/, which the whole of Kconfig
# guards with `if LEDS_CLASS_MULTICOLOR`, so without this the request for it
# is invisible rather than refused.
CONFIG_LEDS_CLASS_MULTICOLOR=y
CONFIG_LEDS_QCOM_LPG=y
CONFIG_LEDS_TRIGGER_TIMER=y
CONFIG_POWER_RESET_QCOM_PON=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_PM8XXX=y
CONFIG_IIO=y
CONFIG_QCOM_SPMI_VADC=y
CONFIG_QCOM_SPMI_IADC=y
CONFIG_QCOM_SPMI_ADC_TM5=y
CONFIG_QCOM_PMIC_GLINK=y
CONFIG_TYPEC=y
CONFIG_TYPEC_UCSI=y
CONFIG_UCSI_PMIC_GLINK=y
CONFIG_BATTERY_QCOM_BATTMGR=y
CONFIG_POWER_SUPPLY=y
CONFIG_QCOM_QMI_HELPERS=y

# ---- storage: UFS with ICE, microSD
CONFIG_SCSI=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_SCSI_UFS_CRYPTO=y
CONFIG_SCSI_UFS_BSG=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_IO_ACCESSORS=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_MSM=y
CONFIG_MMC_CQHCI=y
CONFIG_MMC_CRYPTO=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_PHY_QCOM_QMP_COMBO=y
CONFIG_PHY_QCOM_QMP_PCIE=y
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y

# ---- USB: gadget is the console until the panel works
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_F_FS=y
# f_acc and f_audio_source were dropped upstream; adb, mtp and ptP on Android
# 11+ all go through f_fs, which is above.
CONFIG_USB_ACM=y
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_CONSOLE=y
CONFIG_USB_SERIAL_QCAUX=y
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_NET_RNDIS_HOST=y
CONFIG_USB_NET_QMI_WWAN=y

# ---- display: DPU + DSI + panel + backlight; mainline has a real VT
CONFIG_DRM=y
CONFIG_DRM_MSM=y
CONFIG_DRM_DISPLAY_DP_AUX_CHARDEV=y
CONFIG_DRM_PANEL=y
CONFIG_DRM_PANEL_SIMPLE=y
CONFIG_DRM_PANEL_XIAOMI_C3F=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_FBDEV_OVERALLOC=100
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_FB=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_LOGO=y
CONFIG_SYNC_FILE=y
CONFIG_UDMABUF=y
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_DMABUF_HEAPS_CMA=y
CONFIG_CMA=y

# ---- input
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_UINPUT=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_EDT_FT5X06=y
CONFIG_HID=y
CONFIG_HID_MULTITOUCH=y

# ---- sound: LPASS macros, soundwire, smartpa
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_QCOM=y
CONFIG_SND_SOC_SC8280XP=y
CONFIG_SND_SOC_WCD938X=y
CONFIG_SND_SOC_WCD938X_SDW=y
CONFIG_SND_SOC_WCD939X=y
CONFIG_SND_SOC_WCD939X_SDW=y
CONFIG_SND_SOC_WSA884X=y
CONFIG_SND_SOC_WSA881X=y
CONFIG_SND_SOC_WSA883X=y
CONFIG_SND_SOC_AW88166=y
CONFIG_SND_SOC_LPASS_WSA_MACRO=y
CONFIG_SND_SOC_LPASS_VA_MACRO=y
CONFIG_SND_SOC_LPASS_RX_MACRO=y
CONFIG_SND_SOC_LPASS_TX_MACRO=y
CONFIG_SOUNDWIRE=y
CONFIG_SOUNDWIRE_QCOM=y

# ---- wireless: BT is hci_qca; the WCN3990 WLAN path is still open
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_CFG80211_WEXT=y
CONFIG_MAC80211=y
CONFIG_NL80211_TESTMODE=y
CONFIG_RFKILL=y
CONFIG_BT=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_QCA=y
CONFIG_BT_QCA=y
CONFIG_WCN36XX=y
CONFIG_ATH10K=y
CONFIG_ATH10K_SNOC=y
CONFIG_ATH11K=y
CONFIG_CRC8=y

# ---- remoteproc / glink / fastrpc (ADSP for audio, WPSS for wifi)
CONFIG_REMOTEPROC=y
CONFIG_QCOM_RPROC_COMMON=y
CONFIG_QCOM_MDT_LOADER=y
CONFIG_QCOM_Q6V5_MSS=y
CONFIG_QCOM_Q6V5_ADSP=y
CONFIG_QCOM_Q6V5_PAS=y
CONFIG_QCOM_Q6V5_WCSS=y
CONFIG_QCOM_SYSMON=y
CONFIG_RPMSG_QCOM_GLINK=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_RPMSG_QCOM_GLINK_RPM=y
CONFIG_QCOM_APR=y
CONFIG_RPMSG_QCOM_SMD=y
CONFIG_QCOM_FASTRPC=y
CONFIG_QRTR=y
CONFIG_QRTR_SMD=y

# ---- filesystems + container support (Debian rootfs, Waydroid)
CONFIG_EXT4_FS=y
CONFIG_F2FS_FS=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_NET_NS=y
CONFIG_OVERLAY_FS=y
CONFIG_FUSE_FS=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_WRITEBACK=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_DEVICE=y
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
# ashmem was removed from upstream: Android 11+ passes the
# buffers over binder's own dmabuf heap, so nothing needs it.
CONFIG_KEYS=y
CONFIG_SECURITY_APPARMOR=y
# the ROM's init sets up zram swap on a 4 GB device, and with no module
# channel it has to be built in or the swap line in fstab.qcom just fails.
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
CONFIG_ZRAM_BACKEND_LZO=y
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# ---- networking
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_BRIDGE=y

# ---- debug
CONFIG_DEBUG_KERNEL=y
CONFIG_FTRACE=y
CONFIG_KALLSYMS=y
CONFIG_PRINTK_TIME=y

# ---- boot handover (see arch/arm64/kernel/handover.c, tools/shim.S)
# Both of these are load bearing, not tuning: without the hook the kernel never
# sees ABL's androidboot.* tags or the address of the ROM's first stage init
# ramdisk, and with INITRD off it could not load that ramdisk if it did. CI
# asserts both are still y after olddefconfig.
CONFIG_ARM64_HANDOVER_CMDLINE=y
CONFIG_BLK_DEV_INITRD=y
