# ---- scheduler and io controls lmkd, traffic-control and the cpuset governor use
# PSI is how lmkd gets memory-pressure events (without it the killer falls back
# to polling), uclamp is what the vendor perf HAL writes, blk-throttling and
# cgroup net prio back the per-app io/net limits.
CONFIG_BLK_CGROUP_IOCOST=y
CONFIG_BLK_CGROUP_IOPRIO=y
CONFIG_BLK_CGROUP_RWSTAT=y
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_BLK_RQ_ALLOC_TIME=y
CONFIG_BLK_WBT=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_PSI=y
CONFIG_UCLAMP_BUCKETS_COUNT=20
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y

# ---- zoned block devices
# dm-default-key and dm-crypt test for it, and UFS ZNS support is in stock.
CONFIG_BLK_DEV_ZONED=y

# ---- USB functions the framework opens through configfs
# midi/audio/hid are needed by the corresponding HALs; uas matters for the
# microSD/MTP path and hiddev for input devices over OTG.
CONFIG_USB_CONFIGFS_F_HID=y
CONFIG_USB_CONFIGFS_F_MIDI=y
CONFIG_USB_CONFIGFS_F_UAC2=y
CONFIG_USB_HIDDEV=y
CONFIG_USB_UAS=y

# ---- odds and ends stock has that userspace probes for
# NLS utf8/ascii/cp437 back the vfat and casefolding paths on /sdcard-style
# volumes; wakelocks are the /sys/power/wake_lock node the power HAL expects.
CONFIG_NLS_ASCII=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_UTF8=y
CONFIG_PM_WAKELOCKS=y
CONFIG_PM_WAKELOCKS_LIMIT=0
# ART's concurrent-copying GC and lmkd's page-pin path both call userfaultfd(2)
# and both were built against a stock kernel that has it (=y in stock/gki.config
# and in the extracted vendor config).  7.1.2 still defines the symbol, so this
# is not a porting gap, it is a line the first audit missed: with it off the
# syscall returns ENOSYS, and ART's concurrent-copying collector - what
# system_server is configured to use - cannot initialize without it.
CONFIG_USERFAULTFD=y

# ---- bpf, probes and the per-process knobs userspace reads
# bpfloader installs cgroup/sk_msg programs and the LSM= line above ends in
# `bpf`, which only exists as a hook with BPF_LSM; stock sets it, with
# BPF_JIT_ALWAYS_ON and KPROBES.  ANON_VMA_NAME is what names the ART and
# graphics regions in /proc/<pid>/maps, GPIO_CDEV_V1 is the char-device ABI the
# shipped HALs were built against, SCHEDSTATS/LRU_GEN/BINFMT_MISC/IFB/
# NET_REDIRECT are all in stock (binfmt_misc registrations, the old-anon LRU,
# and the tc redirect offload netd installs).  Not settable here, so absent by
# need rather than choice: KPROBES_ON_FTRACE needs DYNAMIC_FTRACE_WITH_REGS
# which arm64 does not have, and SCHED_DEBUG / SCHED_THERMAL_PRESSURE became
# runtime sysctls upstream.
CONFIG_ANON_VMA_NAME=y
CONFIG_BINFMT_MISC=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_BPF_LSM=y
CONFIG_GPIO_CDEV_V1=y
CONFIG_IFB=y
CONFIG_KPROBES=y
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_LRU_GEN_WALKS_MMU=y
CONFIG_NET_REDIRECT=y
CONFIG_SCHEDSTATS=y

# ---- BTF, which is what makes the ROM's bpf programs loadable
# bpfloader runs before netd and loads /system/etc/bpf/*.o with libbpf, and
# those objects carry CO-RE relocations: libbpf resolves them against
# /sys/kernel/btf/vmlinux, so a kernel without BTF fails every one of them and
# the cgroup/sk_msg programs netd and the stats HALs depend on never attach.
# Stock ships it (=y, with DEBUG_INFO and DWARF5).  DEBUG_INFO costs build time
# on the runner and nothing on the device: objcopy -O binary keeps allocated
# sections only, so the Image grows by the BTF blob and not by the DWARF.
# DEBUG_INFO_BTF depends on PAHOLE_VERSION >= 122, which is probed from the
# pahole that is installed when olddefconfig runs - the reason the job installs
# `dwarves` before configuring, and why a runner without it fails the =y audit
# out loud instead of shipping a kernel silently missing /sys/kernel/btf.  It
# also depends on !DEBUG_INFO_REDUCED, and arch/arm64/configs/defconfig turns
# that on, so it has to be switched back off here: that is what the first BTF
# build died on.
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_REDUCED=n
CONFIG_DEBUG_INFO_BTF=y

# ---- what the stock GKI config has and this one did not
# Checked one by one against stock/gki.config, the /proc/config-equivalent of
# the 6.6.82 GKI kernel this ROM ships, which is the only honest statement of
# what its userspace was built expecting.  Anything stock has as =m is a
# feature whose interface the ROM opens later through a .ko; with
# CONFIG_MODULES=n there is no later, so it has to be =y here or the interface
# simply never exists.  Four symbols on the same candidate list are deliberately
# NOT set because stock does not have them either - CRYPTO_USER_API,
# CRYPTO_USER_API_AEAD, USB_CONFIGFS_F_PRINTER, USB_CONFIGFS_F_UAC1 - and adding
# an interface nothing asks for is attack surface and Image bytes, not a
# feature.  All of these were verified to survive the CI merge below
# (defconfig -> =m demotion -> merge -> olddefconfig), which is why none of them
# is a symbol that merely exists: DRM_TTM, USB_VIDEO_CLASS, V4L2_MEM2MEM_DEV and
# VIDEOBUF2_DMA_CONTIG are real Kconfig names that olddefconfig still will not
# turn on here, and a fragment line for any of them would fail the =y audit.

# V4L2/media controller, as stock has it.  CamX opens /dev/media%d and runs
# MEDIA_IOC_DEVICE_INFO and ENUM_ENTITIES on it; those ioctls are only served
# when CONFIG_MEDIA_CONTROLLER is on, and without the media device the HAL's
# pipeline setup has nothing to enumerate (see the camera section of
# docs/mainline-port.md for what it then does on this SoC).
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_MEDIA_PLATFORM_SUPPORT=y
CONFIG_MEDIA_CONTROLLER=y
CONFIG_VIDEO_DEV=y
CONFIG_V4L2_ASYNC=y
CONFIG_V4L2_FWNODE=y
CONFIG_VIDEOBUF2_CORE=y
CONFIG_VIDEOBUF2_MEMOPS=y
CONFIG_VIDEOBUF2_VMALLOC=y
CONFIG_VIDEOBUF2_DMA_SG=y
CONFIG_VIDEOBUF2_V4L2=y

# Thermal, as stock has it: THERMAL_NETLINK is what serves /dev/thermal, the
# netlink family the Android thermal HAL reads trip and cooling-device state
# from; the two governors are the ones a userspace governor (thermal-engine in
# the ROM) can fall back to.
CONFIG_THERMAL_NETLINK=y
CONFIG_THERMAL_GOV_BANG_BANG=y
CONFIG_THERMAL_GOV_USER_SPACE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_DEVFREQ_GOV_POWERSAVE=y

# Type-C, as stock has it.  android.hardware.usb and the display HAL look at
# /sys/class/typec/ and at the altmode devices for DP over USB-C; TYPEC itself
# was already set above, this is the port controller side of it.
CONFIG_TYPEC_TCPM=y
CONFIG_TYPEC_TCPCI=y
CONFIG_TYPEC_DP_ALTMODE=y

# Flash LED class: the torch and camera HALs drive the flashlight through the
# flash-specific attributes (flash_brightness, flash_strobe, flash_timeout) that
# only exist under LEDS_CLASS_FLASH, and INPUT_FF_MEMLESS is the force-feedback
# backend the vibrator's input device registers.
CONFIG_LEDS_CLASS_FLASH=y
CONFIG_INPUT_FF_MEMLESS=y

# Subsystem debug and rpmsg char devices, both =y in stock.  REMOTEPROC_CDEV is
# what makes /dev/remoteproc/<name> appear, and the ROM's SSR/ramdump path uses
# it (devdump, recovery, state); RPMSG_CHAR gives /dev/rpmsg-* for the clients
# that are not on qrtr.
CONFIG_REMOTEPROC_CDEV=y
CONFIG_RPMSG_CHAR=y

# USB host-side class drivers.  Stock has these as =m in the vendor module
# partition.  They matter here for one practical reason beyond parity: with no
# Wi-Fi and no SLPI, a USB ethernet adapter is the only way to reach the device
# for bringup, and the FTDI and CDC-ACM paths are how a serial console cable
# shows up.  USB_CONFIGFS_F_UVC is =y in stock as a gadget function.
CONFIG_SND_USB_AUDIO=y
CONFIG_USB_NET_AX88179_178A=y
CONFIG_USB_RTL8152=y
CONFIG_USB_SERIAL_FTDI_SIO=y
CONFIG_USB_CONFIGFS_F_UVC=y

# put the security= default on selinux, as stock does; this is a choice so it has
# to be the last word on it in the file
CONFIG_DEFAULT_SECURITY_SELINUX=y
