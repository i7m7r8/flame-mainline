# flame mainline kernel fragment, merged over arch/arm64/configs/defconfig.
# Unknown symbols are silently dropped by olddefconfig; CI greps this list into
# enabled.txt so a typo shows up as a missing driver rather than a silent hang.

# ---- no modules, ever
# The ROM's first stage insmods 94 stock .ko files, and no channel exists to
# deliver rebuilt ones: the boot image has a kernel section only, /vendor is
# read-only under AVB, and a mainline .ko would not load into a stock kernel or
# the other way round. So a driver configured =m simply does not exist for
# Android, and CONFIG_MODULES=n is what makes that visible at build time:
# with it off, olddefconfig silently demotes every =y below whose dependency is
# a module - DRM_MSM, the whole SND_SOC_QCOM family, remoteproc, LPG LEDs -
# and the Image links without them. It also saves building 1332 unusable
# modules.
CONFIG_MODULES=n

# ---- SoC bus / firmware glue
CONFIG_ARCH_QCOM=y
CONFIG_QCOM_SCM=y
CONFIG_QCOM_SMEM=y
# ROCKNIX 0045 puts qcom_serial_number in socinfo.c and reads it from ath10k
# and btqca, both built in here. As a module its data symbol is not in vmlinux
# and the link fails; it also has to be up before the wifi/bt firmware names
# are derived, so built-in is what flame wants anyway.
CONFIG_QCOM_SOCINFO=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_QCOM_PDC=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_WDT=y
CONFIG_QCOM_STATS=y
CONFIG_QCOM_TSENS=y
CONFIG_QCOM_SPMI_TEMP_ALARM=y
CONFIG_NVMEM=y
CONFIG_NVMEM_QCOM_QFPROM=y
CONFIG_NVMEM_QCOM_SEC_QFPROM=y
CONFIG_RESET_QCOM_PDC=y

# ---- clocks / pinctrl / interconnect / iommu
CONFIG_SM_GCC_4450=y
CONFIG_SM_GPUCC_4450=y
CONFIG_SM_DISPCC_4450=y
CONFIG_SM_CAMCC_4450=y
CONFIG_PINCTRL_SM4450=y
CONFIG_INTERCONNECT=y
CONFIG_INTERCONNECT_QCOM=y
CONFIG_INTERCONNECT_QCOM_RPMH=y
CONFIG_INTERCONNECT_QCOM_BCM_VOTER=y
CONFIG_INTERCONNECT_QCOM_OSM_L3=y
CONFIG_INTERCONNECT_QCOM_SM4450=y
CONFIG_ARM_SMMU=y
CONFIG_ARM_SMMU_QCOM=y
CONFIG_IOMMU_IO_PGTABLE_ARMV7S=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_IDLE_GOV_MENU=y
CONFIG_THERMAL_GOV_POWER_ALLOCATOR=y
CONFIG_PM_DEVFREQ=y
CONFIG_DEVFREQ_GOV_SIMPLE_ONDEMAND=y
CONFIG_DEVFREQ_GOV_PERFORMANCE=y
CONFIG_DEVFREQ_GOV_USERSPACE=y

