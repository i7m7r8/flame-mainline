/*
 * ---------------------------------------------------------------------------
 * sky board additions
 * ---------------------------------------------------------------------------
 */

/ {
	/* Display rails: vendor DT "display_gpio_regulator@0..2" +
	 * "display_panel_ibb_stub". GPIOs: vddio = PM6450 gpio11,
	 * extvdd = PM6450 gpio12, avdd = TLMM gpio127, ibb = ABL/labibb.
	 */
	display_panel_vddio: regulator-panel-vddio {
		compatible = "regulator-fixed";
		regulator-name = "display_panel_vddio";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		gpio = <&pm6450_gpios 11 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
	};

	display_panel_extvdd: regulator-panel-extvdd {
		compatible = "regulator-fixed";
		regulator-name = "display_panel_extvdd";
		regulator-min-microvolt = <1200000>;
		regulator-max-microvolt = <1200000>;
		gpio = <&pm6450_gpios 12 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
	};

	display_panel_avdd: regulator-panel-avdd {
		compatible = "regulator-fixed";
		regulator-name = "display_panel_avdd";
		regulator-min-microvolt = <5500000>;
		regulator-max-microvolt = <5500000>;
		gpio = <&tlmm 127 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
	};

	/* no control GPIO in the vendor DT: the rail is left as the bootloader
	 * programmed it until the panel driver knows better */
	display_panel_ibb: regulator-panel-ibb {
		compatible = "regulator-fixed";
		regulator-name = "display_panel_ibb";
		regulator-min-microvolt = <4600000>;
		regulator-max-microvolt = <6000000>;
		regulator-boot-on;
	};

	/* pstore across resets (vendor: ramoops@97700000) */
	reserved-memory {
		ramoops_region: ramoops@97700000 {
			compatible = "ramoops";
			reg = <0x0 0x97700000 0x0 0x200000>;
			record-size = <0x20000>;
			console-size = <0x100000>;
			pmsg-size = <0x40000>;
			no-map;
		};
	};
};

/* mainline's sm4450.dtsi expects the bootloader to fill /memory in; the shim
 * passes the DTB as-is, so provide the low bank here (M1 placeholder: first
 * region of sky's vendor /memory, see docs/C-sky-hw-params.md section 2). */
/ {
	/delete-node/ memory@a0000000;

	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x0 0x68e00000>; /* PROVISIONAL: verify from live DT */
	};
};
