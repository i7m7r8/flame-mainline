From: i7m7r8 <i7m7r8@users.noreply.github.com>
Subject: [PATCH] blk-crypto, fscrypt, f2fs: the bio flag dm-default-key reads

drivers/md/dm-default-key.c (installed from patches/local/files/) skips a bio
when bio_should_skip_dm_default_key() says so, because that bio is the content
of a file fscrypt has already encrypted with a per-file key.  Nothing in mainline
sets or stores that decision, so this adds it: a bool in struct bio, reset in
bio_init() and copied by bio_crypt_clone(), the three helpers next to the other
blk-crypto bio accessors, fscrypt_set_bio_crypt_ctx() and fscrypt_mergeable_bio()
using it, and f2fs's garbage collector path - which writes a bounce page of raw
ciphertext and so never reaches fscrypt_set_bio_crypt_ctx() - setting it directly.

Upstream these are the Android common tree commits
"blk-crypto: add BIO_SKIP_DM_DEFAULT_KEY" and "fscrypt: skip dm-default-key for
encrypted files"; they are not in mainline because the target they serve is not
in mainline either.

---
--- a/include/linux/blk_types.h
+++ b/include/linux/blk_types.h
@@ -261,6 +261,9 @@
 
 #ifdef CONFIG_BLK_INLINE_ENCRYPTION
 	struct bio_crypt_ctx	*bi_crypt_context;
+#if IS_ENABLED(CONFIG_DM_DEFAULT_KEY)
+	bool			bi_skip_dm_default_key;
+#endif
 #endif
 
 #if defined(CONFIG_BLK_DEV_INTEGRITY)
--- a/block/bio.c
+++ b/block/bio.c
@@ -243,6 +243,9 @@
 #endif
 #ifdef CONFIG_BLK_INLINE_ENCRYPTION
 	bio->bi_crypt_context = NULL;
+#if IS_ENABLED(CONFIG_DM_DEFAULT_KEY)
+	bio->bi_skip_dm_default_key = false;
+#endif
 #endif
 #ifdef CONFIG_BLK_DEV_INTEGRITY
 	bio->bi_integrity = NULL;
--- a/include/linux/blk-crypto.h
+++ b/include/linux/blk-crypto.h
@@ -204,6 +204,8 @@
 }
 
 int __bio_crypt_clone(struct bio *dst, struct bio *src, gfp_t gfp_mask);
+static inline void bio_clone_skip_dm_default_key(struct bio *dst,
+						 const struct bio *src);
 /**
  * bio_crypt_clone - clone bio encryption context
  * @dst: destination bio
@@ -218,9 +220,52 @@
 static inline int bio_crypt_clone(struct bio *dst, struct bio *src,
 				  gfp_t gfp_mask)
 {
+	bio_clone_skip_dm_default_key(dst, src);
 	if (bio_has_crypt_ctx(src))
 		return __bio_crypt_clone(dst, src, gfp_mask);
 	return 0;
 }
 
+#if IS_ENABLED(CONFIG_DM_DEFAULT_KEY)
+/**
+ * bio_set_skip_dm_default_key() - Mark this bio as one that dm-default-key
+ *                                 should not encrypt with its default key.
+ * @bio: the bio
+ *
+ * This is called on the bios of encrypted files' contents, which fscrypt
+ * encrypts with a per-file key.  dm-default-key exists to encrypt what fscrypt
+ * cannot, i.e. the filesystem metadata and the contents of unencrypted files,
+ * so it must leave these bios alone.
+ */
+static inline void bio_set_skip_dm_default_key(struct bio *bio)
+{
+	bio->bi_skip_dm_default_key = true;
+}
+
+static inline bool bio_should_skip_dm_default_key(const struct bio *bio)
+{
+	return bio->bi_skip_dm_default_key;
+}
+
+static inline void bio_clone_skip_dm_default_key(struct bio *dst,
+						 const struct bio *src)
+{
+	dst->bi_skip_dm_default_key = src->bi_skip_dm_default_key;
+}
+#else /* CONFIG_DM_DEFAULT_KEY */
+static inline void bio_set_skip_dm_default_key(struct bio *bio)
+{
+}
+
+static inline bool bio_should_skip_dm_default_key(const struct bio *bio)
+{
+	return false;
+}
+
+static inline void bio_clone_skip_dm_default_key(struct bio *dst,
+						 const struct bio *src)
+{
+}
+#endif /* !CONFIG_DM_DEFAULT_KEY */
+
 #endif /* __LINUX_BLK_CRYPTO_H */
--- a/fs/crypto/inline_crypt.c
+++ b/fs/crypto/inline_crypt.c
@@ -303,6 +303,13 @@
 	const struct fscrypt_inode_info *ci;
 	u64 dun[BLK_CRYPTO_DUN_ARRAY_SIZE];
 
+	/*
+	 * The contents of an encrypted file are encrypted with that file's key,
+	 * so dm-default-key must not encrypt them again with its default key.
+	 */
+	if (fscrypt_needs_contents_encryption(inode))
+		bio_set_skip_dm_default_key(bio);
+
 	if (!fscrypt_inode_uses_inline_crypto(inode))
 		return;
 	ci = fscrypt_get_inode_info_raw(inode);
@@ -342,6 +349,9 @@
 
 	if (!!bc != fscrypt_inode_uses_inline_crypto(inode))
 		return false;
+	if (bio_should_skip_dm_default_key(bio) !=
+	    fscrypt_needs_contents_encryption(inode))
+		return false;
 	if (!bc)
 		return true;
 	ci = fscrypt_get_inode_info_raw(inode);
--- a/fs/f2fs/data.c
+++ b/fs/f2fs/data.c
@@ -531,6 +531,8 @@
 		fscrypt_set_bio_crypt_ctx(bio, inode,
 				(loff_t)first_idx << inode->i_blkbits,
 				gfp_mask);
+	else if (fscrypt_needs_contents_encryption(inode))
+		bio_set_skip_dm_default_key(bio);
 }
 
 static bool f2fs_crypt_mergeable_bio(struct bio *bio, const struct inode *inode,
@@ -542,7 +544,9 @@
 	 * read/write raw data without encryption.
 	 */
 	if (fio && fio->encrypted_page)
-		return !bio_has_crypt_ctx(bio);
+		return !bio_has_crypt_ctx(bio) &&
+			(bio_should_skip_dm_default_key(bio) ==
+			 fscrypt_needs_contents_encryption(inode));
 
 	return fscrypt_mergeable_bio(bio, inode,
 			(loff_t)next_idx << inode->i_blkbits);
