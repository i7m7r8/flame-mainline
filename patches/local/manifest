# Rules for tools/install_local.py:
#   FILE | anchor regex | before|after | MARKER | text
# \t and \n in the text are escapes. The anchor must exist in the target or
# the install step fails loudly instead of quietly dropping a driver. MARKER
# makes the rule idempotent (and a no-op if upstream grows the same line).

drivers/gpu/drm/panel/Makefile | ^\s*obj-\$\(CONFIG_DRM_PANEL_SIMPLE\) | after | DRM_PANEL_XIAOMI_C3F | obj-$(CONFIG_DRM_PANEL_XIAOMI_C3F) += panel-xiaomi-c3f.o

drivers/gpu/drm/panel/Kconfig | ^endmenu$ | before | DRM_PANEL_XIAOMI_C3F | \nconfig DRM_PANEL_XIAOMI_C3F\n\ttristate "Xiaomi c3f 720x1640 DSI video mode panel"\n\tdepends on OF\n\tdepends on DRM_MIPI_DSI\n\thelp\n\t  Say Y here if you want to enable support for the c3f 4-lane\n\t  720x1640 MIPI DSI video mode panel, as fitted to the Xiaomi\n\t  Redmi 14C 5G and POCO M7 5G (Qualcomm SM4450). Brightness is\n\t  a 12-bit DCS 0x51 write, handled by the panel itself.\n

drivers/input/touchscreen/edt-ft5x06.c | \.compatible = "focaltech,ft8719" | after | focaltech,ft8726 | \t{ .compatible = "focaltech,ft8726", .data = &edt_ft8719_data },

# The handover hook. Four rules, because the object has to be built, the option
# has to exist, and the two jobs have two different call sites.
#
# The Makefile anchor is deliberately `obj-y += head.o` rather than the obj-y
# list at the top of the file: that list is one backslash-continued statement
# over eight lines, and inserting a line inside it would silently truncate the
# continuation. head.o is a standalone rule near the end and has been in every
# arm64 Makefile since the architecture existed.

arch/arm64/kernel/Makefile | ^obj-y\s*\+= head\.o$ | after | ARM64_HANDOVER_CMDLINE | obj-$(CONFIG_ARM64_HANDOVER_CMDLINE)\t\t+= handover.o

arch/arm64/Kconfig | ^source "kernel/livepatch/Kconfig"$ | after | ARM64_HANDOVER_CMDLINE | \nconfig ARM64_HANDOVER_CMDLINE\n\tbool "Recover the bootloader's device tree through the EL1 handover shim"\n\tdepends on OF\n\thelp\n\t  The flame boot image starts with an EL1 shim that enters the kernel\n\t  with our own device tree, because the one the Qualcomm bootloader\n\t  builds binds only vendor drivers. That tree also carries what ABL\n\t  injected at run time: the androidboot.* tags init needs to find the\n\t  active slot and the AVB chain, the address of the ROM's first\n\t  stage init ramdisk, and the DRAM map read from the memory\n\t  controller. With this on, the shim parks that tree in a reserved\n\t  region and these hooks graft the three of them onto our own boot.\n\n\t  If unsure, say N: a kernel without it boots normally but cannot run\n\t  an Android userspace that mounts /vendor.\n

# setup.c: include the prototype, then call it. The command line and the ramdisk
# go after paging_init(), because that is what builds the linear map the parked
# tree is read through, and must precede mm_init(), where the page allocator
# takes every page memblock has not been told to keep. asm/handover.h compiles
# to a no-op stub when the option is off, so neither call site needs an ifdef.

arch/arm64/kernel/setup.c | ^#include <asm/setup.h>$ | after | asm/handover.h | #include <asm/handover.h>

arch/arm64/kernel/setup.c | ^\tpaging_init\(\);$ | after | handover_cmdline_extend(); | \thandover_cmdline_extend();	/* flame: see arch/arm64/kernel/handover.c */

# The memory graft has the opposite timing: memblock gets its ranges from the
# flat-tree scan here, and paging_init() builds the linear map out of exactly
# those, so this one has to land between the mapping of our own tree and the
# scan of it.

arch/arm64/kernel/setup.c | ^\tif \(!early_init_dt_scan\(dt_virt, dt_phys\)\) \{$ | before | handover_memory_fixup(dt_virt, dt_phys); | \thandover_memory_fixup(dt_virt, dt_phys);	/* flame: ABL has the DRAM map, our DTS can only guess it */

# dm-default-key: the target fs_mgr builds for this ROM's metadata encryption.
# Mainline never carried it, so the source is a files/ copy and the two lines
# that select it are inserted here.  Anchored rather than patched because the
# surrounding DM Kconfig text is rewritten every other release.

drivers/md/Makefile | ^obj-\$\(CONFIG_DM_CRYPT\)\s*\+= dm-crypt\.o$ | after | dm-default-key.o | obj-$(CONFIG_DM_DEFAULT_KEY)\t+= dm-default-key.o

drivers/md/Kconfig | ^config DM_SNAPSHOT$ | before | config DM_DEFAULT_KEY | config DM_DEFAULT_KEY\n\ttristate "Default key target (filesystem metadata encryption)"\n\tdepends on BLK_DEV_DM\n\tdepends on BLK_INLINE_ENCRYPTION\n\thelp\n\t  This device-mapper target encrypts everything written to the device\n\t  with one key, except for data that fscrypt has already encrypted\n\t  with a per-file key.  It is what Android's fs_mgr puts below /data\n\t  for metadata encryption.\n\n\t  To compile this code as a module, choose M here: the module will\n\t  be called dm-default-key.\n\n\t  If unsure, say N.\n\n

# pstore_blk attaches at late_initcall, which is the last initcall level - and
# the disk that holds "oops" is not necessarily registered by then. The ufs
# host is a platform device that can still be deferred-probing, and the sd disk
# itself appears from async work (sd_probe_async registers the gendisk, and the
# partition table is read as part of that). resolve-then-give-up means the
# backend never attaches, so a kernel that panics or hangs writes no record
# anywhere: which is exactly the "no boot log" this device has shown. The name
# is resolved here only to decide whether to keep waiting; the real registration
# below stays upstream's.
fs/pstore/blk.c | ^#include <linux/mount.h>$ | after | linux/delay.h | #include <linux/delay.h>\t/* flame: pstore_blk waits for the disk */\n#include <linux/async.h>

fs/pstore/blk.c | ^\tbest_effort_dev = kzalloc_obj\(\*best_effort_dev\);$ | before | async_synchronize_full | \t/* Bounded, and free in the normal case where the disk is already\n\t * there: async_synchronize_full drains what has been scheduled, then the\n\t * name is retried for up to five more seconds in case a deferred probe\n\t * has not reached this device yet. init/do_mounts.c does the same\n\t * two things - wait_for_device_probe(), retry the name, then\n\t * async_synchronize_full() - before it trusts a root= device name.\n\t */\n\tasync_synchronize_full();\n\tfor (int waited = 0; waited < 5000; waited += 100) {\n\t\tdev_t dev;\n\n\t\tif (!early_lookup_bdev(blkdev, &dev))\n\t\t\tbreak;\n\t\tmsleep(100);\n\t}\n\n
# The ROM's graphics stack opens the Qualcomm heap names and nothing else.
# Read out of the vendor binaries rather than assumed: snapalloc's
# SnapDMAAllocator::GetHeapInfo (vendor.qti.hardware.display.snapalloc-impl.so
# @0x2ca58) picks "qcom,system", or "qcom,system-movable"/"qcom,display"/
# "qcom,secure-pixel" for the protected and camera usages, and
# gralloc::DmaManager::GetHeapInfo (libgralloccore.so @0x178f8) adds
# "qcom,system-uncached" and "qcom,adsp". SnapDMAAllocator::AllocBuffer
# (@0x2c444) calls BufferAllocator::Alloc exactly once with that one name and
# returns an error if it fails; BufferAllocator::MapNameToIonHeap
# (libdmabufheap.so @0x9540) is two instructions - "mov w0, wzr; ret" - so the
# name mapping is a stub in this build, and DmabufAlloc (@0x9548) only ever
# ioctls the fd it was handed. There is no fallback to the generic names
# anywhere on the path, so a kernel that registers only "system" gives
# SurfaceFlinger no buffer at all.
# Four of the names below come straight out of that chain. The other two -
# qcom,user-contig and qcom,demura - are not on the proven path, they are in
# the ROM's own vendor_file_contexts (/dev/dma_heap/qcom,user-contig,
# /dev/dma_heap/qcom,demura), so something in the image does try to open them
# and an absent node is a hard failure there too. Aliasing them to the system
# heap is safe for the same reason the display alias is: on this SoC the
# display, camera and codec masters all sit behind the apps SMMU, so a
# buffer's physical contiguity is not something those masters observe.
drivers/dma-buf/heaps/Kconfig | ^config DMABUF_HEAPS_CMA$ | before | DMABUF_HEAPS_QCOM_COMPAT | \nconfig DMABUF_HEAPS_QCOM_COMPAT\n\tbool "DMA-BUF Qualcomm heap name aliases"\n\tdepends on DMABUF_HEAPS_SYSTEM\n\thelp\n\t  Register the heap names Qualcomm vendor userspace opens -\n\t  /dev/dma_heap/qcom,system and friends - as extra names for the\n\t  system heap. Only the names are aliased: the pages still come from\n\t  the buddy allocator, so nothing secure and nothing shared with a\n\t  DSP is implied. Leave this off on a non-Qualcomm board.\n\n
drivers/dma-buf/heaps/system_heap.c | ^\tif \(IS_ENABLED\(CONFIG_HIGHMEM\) | before | qcom_heap_names | \tif (IS_ENABLED(CONFIG_DMABUF_HEAPS_QCOM_COMPAT)) {\n\t\tstatic const char *const qcom_heap_names[] = {\n\t\t\t"qcom,system", "qcom,system-uncached",\n\t\t\t"qcom,system-movable", "qcom,display",\n\t\t\t"qcom,user-contig", "qcom,demura",\n\t\t};\n\n\t\tfor (unsigned int i = 0; i < ARRAY_SIZE(qcom_heap_names); i++) {\n\t\t\texp_info.name = qcom_heap_names[i];\n\t\t\tsys_heap = dma_heap_add(&exp_info);\n\t\t\tif (IS_ERR(sys_heap))\n\t\t\t\treturn PTR_ERR(sys_heap);\n\t\t}\n\t}\n\n

# Who owns card0, controlD64 and renderD128. DRM allocates primary and render
# minors from one xarray in registration order (drm_drv.c: drm_minor_get_xa(),
# drm_minor_alloc(), DRM_MINOR_LIMIT() caps RENDER at 128..191), so the first
# driver to call drm_dev_register() takes card0 and renderD128 - and on this
# ROM those two names are the only DRM nodes anything may open, because
# /vendor/etc/selinux/vendor_file_contexts labels exactly
# /dev/dri/card0, /dev/dri/controlD64 and /dev/dri/renderD128 as
# graphics_device and everything else falls back to `device`, which
# plat_sepolicy.cil neverallows any domain to read, write or open.
#
# vgem's own initcall beat msm to it: msm registers only once every component
# has bound, so vgem took card0/renderD128 and the real card landed on
# card1/renderD129, where nothing can open it - display dead. 0008 drops
# vgem's initcall (and its __init marking, since a component bind can run
# after init memory is freed) and this line calls it from here instead, after
# msm's own registration succeeded. msm then holds the three labelled names
# and vgem sits at renderD129, which is all libgsl.so needs:
# gsl_ioctl_init (@0xc8054) gates its DRM backend on access("/dev/dri/
# renderD129", F_OK) - existence only - and ioctl_drm_driver_entry (@0x21d3e0)
# readdir()s /dev/dri picking the card whose DRM_IOCTL_VERSION name is "msm",
# logging and continuing when an individual open() fails.
#
# Needs CONFIG_DRM_VGEM=y, not m: this is a direct call into vgem.
drivers/gpu/drm/msm/msm_drv.c | ^\tret = msm_debugfs_late_init\(ddev\);$ | before | flame: vgem takes the placeholder minor | \t/* flame: vgem takes the placeholder minor, see\n\t * patches/local/0008-drm-vgem-register-from-msm.patch.\n\t */\n\tif (IS_ENABLED(CONFIG_DRM_VGEM)) {\n\t\textern int vgem_init(void);\n\n\t\tvgem_init();\n\t}\n\n

# The ROM's init waits for /sys/kernel/boot_adsp/boot with no timeout, so a
# kernel that does not create it hangs first-class userspace rather than
# degrading it. The source is files/drivers/soc/qcom/adsp_loader_compat.c;
# these two lines build it. Anchored on QCOM_SMEM's neighbour because "after"
# lands inside a Kconfig block, not at its end.

drivers/soc/qcom/Makefile | ^obj-\$\(CONFIG_QCOM_SMEM\)\s*\+=\s*smem\.o$ | after | adsp_loader_compat | obj-$(CONFIG_QCOM_ADSP_LOADER_COMPAT)\t+= adsp_loader_compat.o

drivers/soc/qcom/Kconfig | ^config QCOM_SMD_RPM$ | before | QCOM_ADSP_LOADER_COMPAT | \nconfig QCOM_ADSP_LOADER_COMPAT\n\tbool "Qualcomm ADSP loader sysfs compatibility"\n\tdepends on REMOTEPROC\n\tdepends on OF\n\thelp\n\t  Android's first and second stage boot the ADSP by writing 1 to\n\t  /sys/kernel/boot_adsp/boot, and init's wait on that path has no\n\t  timeout. The vendor adsp_loader module creates it; mainline replaced\n\t  that driver with remoteproc, which exposes the same job under\n\t  /sys/class/remoteproc instead. Say Y on a Qualcomm board running a\n\t  vendor userspace, which cannot be retargeted.

drivers/soc/qcom/Makefile | ^obj-\$\(CONFIG_QCOM_ADSP_LOADER_COMPAT\)\t\+= adsp_loader_compat\.o$ | after | flame_qseecom_shim | obj-$(CONFIG_FLAME_QSEECOM_SHIM)\t+= flame_qseecom_shim.o
drivers/soc/qcom/Kconfig | ^config QCOM_SMD_RPM$ | before | FLAME_QSEECOM_SHIM | \nconfig FLAME_QSEECOM_SHIM\n\tbool "flame /dev/qseecom compatibility (experimental)"\n\tdepends on QCOM_SCM\n\tdepends on QCOM_TZMEM\n\thelp\n\t  The Infinity X userspace on this phone unlocks /data through\n\t  KeyMint, whose HAL opens /dev/qseecom. Mainline exports the\n\t  QSEECOM SCM calls but no chardev, so this driver maps the two\n\t  ioctls the ROM's libQSEEComAPI issues onto them. It stays\n\t  unbound until the board DTS enables the node, because whether\n\t  TZ resolves the KeyMint app by name is still unmeasured.\n