# Rules for tools/install_local.py:
#   FILE | anchor regex | before|after | MARKER | text
# \t and \n in the text are escapes. The anchor must exist in the target or
# the install step fails loudly instead of quietly dropping a driver. MARKER
# makes the rule idempotent (and a no-op if upstream grows the same line).

drivers/gpu/drm/panel/Makefile | ^\s*obj-\$\(CONFIG_DRM_PANEL_SIMPLE\) | after | DRM_PANEL_XIAOMI_C3F | obj-$(CONFIG_DRM_PANEL_XIAOMI_C3F) += panel-xiaomi-c3f.o

drivers/gpu/drm/panel/Kconfig | ^endmenu$ | before | DRM_PANEL_XIAOMI_C3F | \nconfig DRM_PANEL_XIAOMI_C3F\n\ttristate "Xiaomi c3f 720x1640 DSI video mode panel"\n\tdepends on OF\n\tdepends on DRM_MIPI_DSI\n\thelp\n\t  Say Y here if you want to enable support for the c3f 4-lane\n\t  720x1640 MIPI DSI video mode panel, as fitted to the Xiaomi\n\t  Redmi 14C 5G and POCO M7 5G (Qualcomm SM4450). Brightness is\n\t  a 12-bit DCS 0x51 write, handled by the panel itself.\n

drivers/input/touchscreen/edt-ft5x06.c | \.compatible = "focaltech,ft8719" | after | focaltech,ft8726 | \t{ .compatible = "focaltech,ft8726", .data = &edt_ft8719_data },

# The handover hook. Four rules, because the object has to be built, the option
# has to exist, and the two jobs have two different call sites.
#
# The Makefile anchor is deliberately `obj-y += head.o` rather than the obj-y
# list at the top of the file: that list is one backslash-continued statement
# over eight lines, and inserting a line inside it would silently truncate the
# continuation. head.o is a standalone rule near the end and has been in every
# arm64 Makefile since the architecture existed.

arch/arm64/kernel/Makefile | ^obj-y\s*\+= head\.o$ | after | ARM64_HANDOVER_CMDLINE | obj-$(CONFIG_ARM64_HANDOVER_CMDLINE)\t\t+= handover.o

arch/arm64/Kconfig | ^source "kernel/livepatch/Kconfig"$ | after | ARM64_HANDOVER_CMDLINE | \nconfig ARM64_HANDOVER_CMDLINE\n\tbool "Recover the bootloader's device tree through the EL1 handover shim"\n\tdepends on OF\n\thelp\n\t  The flame boot image starts with an EL1 shim that enters the kernel\n\t  with our own device tree, because the one the Qualcomm bootloader\n\t  builds binds only vendor drivers. That tree also carries what ABL\n\t  injected at run time: the androidboot.* tags init needs to find the\n\t  active slot and the AVB chain, the address of the ROM's first\n\t  stage init ramdisk, and the DRAM map read from the memory\n\t  controller. With this on, the shim parks that tree in a reserved\n\t  region and these hooks graft the three of them onto our own boot.\n\n\t  If unsure, say N: a kernel without it boots normally but cannot run\n\t  an Android userspace that mounts /vendor.\n

# setup.c: include the prototype, then call it. The command line and the ramdisk
# go after paging_init(), because that is what builds the linear map the parked
# tree is read through, and must precede mm_init(), where the page allocator
# takes every page memblock has not been told to keep. asm/handover.h compiles
# to a no-op stub when the option is off, so neither call site needs an ifdef.

arch/arm64/kernel/setup.c | ^#include <asm/setup.h>$ | after | asm/handover.h | #include <asm/handover.h>

arch/arm64/kernel/setup.c | ^\tpaging_init\(\);$ | after | handover_cmdline_extend(); | \thandover_cmdline_extend();	/* flame: see arch/arm64/kernel/handover.c */

# The memory graft has the opposite timing: memblock gets its ranges from the
# flat-tree scan here, and paging_init() builds the linear map out of exactly
# those, so this one has to land between the mapping of our own tree and the
# scan of it.

arch/arm64/kernel/setup.c | ^\tif \(!early_init_dt_scan\(dt_virt, dt_phys\)\) \{$ | before | handover_memory_fixup(dt_virt, dt_phys); | \thandover_memory_fixup(dt_virt, dt_phys);	/* flame: ABL has the DRAM map, our DTS can only guess it */

# dm-default-key: the target fs_mgr builds for this ROM's metadata encryption.
# Mainline never carried it, so the source is a files/ copy and the two lines
# that select it are inserted here.  Anchored rather than patched because the
# surrounding DM Kconfig text is rewritten every other release.

drivers/md/Makefile | ^obj-\$\(CONFIG_DM_CRYPT\)\s*\+= dm-crypt\.o$ | after | dm-default-key.o | obj-$(CONFIG_DM_DEFAULT_KEY)\t+= dm-default-key.o

drivers/md/Kconfig | ^config DM_SNAPSHOT$ | before | config DM_DEFAULT_KEY | config DM_DEFAULT_KEY\n\ttristate "Default key target (filesystem metadata encryption)"\n\tdepends on BLK_DEV_DM\n\tdepends on BLK_INLINE_ENCRYPTION\n\thelp\n\t  This device-mapper target encrypts everything written to the device\n\t  with one key, except for data that fscrypt has already encrypted\n\t  with a per-file key.  It is what Android's fs_mgr puts below /data\n\t  for metadata encryption.\n\n\t  To compile this code as a module, choose M here: the module will\n\t  be called dm-default-key.\n\n\t  If unsure, say N.\n\n
